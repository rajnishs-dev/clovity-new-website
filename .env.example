# ──────────────────────────────────────────────────────────────────────────────
# PUBLIC - inlined into the browser bundle. Never put a secret here.
# ──────────────────────────────────────────────────────────────────────────────

# Canonical origin. Drives canonical URLs, Open Graph URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.clovity.com

# Base URL of the Node.js + Express admin API (phase 2). While the backend does
# not exist yet, leaving this unset makes the data layer fall back to the local
# static content in src/constants - the UI renders identically either way.
NEXT_PUBLIC_API_BASE_URL=

# Milliseconds before an API request is aborted.
NEXT_PUBLIC_API_TIMEOUT=15000

# Feature flag: when "true" every content section fetches from the API instead
# of the bundled static fallback. Flip it on once the CMS is live.
NEXT_PUBLIC_ENABLE_CMS=false

# Search-engine indexing guard. Set to "false" on preview deployments.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Google Search Console verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ──────────────────────────────────────────────────────────────────────────────
# SERVER ONLY - never prefixed with NEXT_PUBLIC_.
# ──────────────────────────────────────────────────────────────────────────────

# Server-to-server key for the admin API, used from Server Components and
# Route Handlers only.
API_SERVER_TOKEN=

# Revalidation secret for the on-demand ISR webhook the CMS will call.
REVALIDATE_SECRET=
