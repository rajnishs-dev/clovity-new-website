# ──────────────────────────────────────────────────────────────────────────────
# PUBLIC — inlined into the browser bundle. Never put a secret here.
# ──────────────────────────────────────────────────────────────────────────────

# Canonical origin. Drives canonical URLs, Open Graph URLs, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.clovity.com

# Milliseconds before a CMS request is aborted.
NEXT_PUBLIC_API_TIMEOUT=15000

# Search-engine indexing guard. Set to "false" on preview deployments.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Google Search Console verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Strapi CMS (the `clovity-admin` app) ─────────────────────────────────────
#
# A SECOND backend, separate from NEXT_PUBLIC_API_BASE_URL above and switched on
# independently of NEXT_PUBLIC_ENABLE_CMS. Setting the URL IS the switch: leave it
# empty and every Strapi-backed section renders its bundled fallback, so the pages
# look identical whether or not the CMS is running.
#
# What reads it today:
#   /about-us  → the "Certifications & Diversity" badge row  (`award`)
#   /careers   → open positions                              (`job`)
#   /careers   → the "Life at Clovity" block                 (`life-at-clovity`)
#   /contact   → which form fields show and which are required (`get-in-touch`)
#   /contact   → submissions               (`contact-us`, `get-in-touch-lead`)
#
# NOTE — these MUST be present in the BUILD environment, not just at runtime: the
# three pages are statically generated, and next.config.ts also reads the URL at
# config-eval time to allow-list the CMS host for next/image.
NEXT_PUBLIC_CMS_API_URL=

# Strapi token the BROWSER sends, for the client-side refetch on About / Careers /
# Contact. Public by definition — anyone can read it in dev tools — so make this a
# READ-ONLY token (Strapi → Settings → API Tokens → Create → Read-only). The
# write-capable one lives in CMS_API_TOKEN below, server-side.
NEXT_PUBLIC_CMS_API_TOKEN=

# Origin serving Strapi's uploaded media, when it differs from the API origin.
# Leave empty when Strapi serves /uploads itself, or when the S3 upload provider
# is configured (it returns absolute URLs and this is not consulted).
NEXT_PUBLIC_CMS_MEDIA_URL=

# ──────────────────────────────────────────────────────────────────────────────
# SERVER ONLY — never prefixed with NEXT_PUBLIC_.
# ──────────────────────────────────────────────────────────────────────────────

# Strapi token used for WRITES — the contact form and the newsletter, both of which
# run in Server Actions. Needs `create` on contact-us / get-in-touch-lead /
# subscribe, plus `find` on the read collections. Nothing else — scope it tightly.
#
# NO NEXT_PUBLIC_ PREFIX, deliberately: that prefix makes Next inline the value into
# the client bundle as a build-time text substitution, which happens even if no
# browser code path reads it. Verified — an earlier revision used the prefixed name
# and the write-capable token was sitting in a public JS chunk.
CMS_API_TOKEN=

# Revalidation secret for the on-demand ISR webhook the CMS will call.
REVALIDATE_SECRET=
